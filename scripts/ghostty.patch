+    self_: ?*Thread,
+    _: *xev.Loop,
+    _: *xev.Completion,
+    r: xev.Timer.RunError!void,
+) xev.CallbackAction {
+    _ = r catch return .disarm;
+    const t = self_ orelse return .disarm;
+    // Drawn since the timer was armed: wait out the rest of the idle time.
+    if (t.renderer.releaseIdleGpuResources(IDLE_GPU_RELEASE_MS)) |left| t.idle_h.run(
+        &t.loop,
+        &t.idle_c,
+        @intCast(@max(left, 1)),
+        Thread,
+        t,
+        idleGpuCallback,
+    );
