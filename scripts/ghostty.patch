+/// lmux: one idle timer per burst of drawing, not one per frame. Also armed
+/// after every wakeup: a sync draw on the main thread (layer display, resize)
+/// doesn't come through here.
+fn armIdleTimer(self: *Thread) void {
+    if (self.idle_c.state() != .active) self.idle_h.run(
+        &self.loop,
+        &self.idle_c,
+        IDLE_GPU_RELEASE_MS,
+        Thread,
+        self,
+        idleGpuCallback,
+    );
