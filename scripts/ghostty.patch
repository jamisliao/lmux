+/// lmux: release the command queue of a surface that stopped drawing (the renderer
+/// releases its swap chain first, which waits for in-flight frames). The process's first
+/// GPU submission makes Metal set up ~80-110 MB of driver memory (Apple silicon, macOS
+/// 26) that lives as long as the queue that submitted it; with every queue gone it is
+/// freed, and the next frame sets it up again (~3 ms).
+pub fn releaseIdle(self: *Metal) void {
+    if (self.queue) |q| q.release();
+    self.queue = null;
+}
+
+/// lmux: whether `target` is the one last handed to the layer.
+pub fn isPresented(self: *const Metal, target: Target) bool {
+    return self.presented.load(.seq_cst) == @intFromPtr(target.surface);
+}
+
 /// Begin a frame.
 pub inline fn beginFrame(
-    self: *const Metal,
+    self: *Metal,
     /// Once the frame has been completed, the `frameCompleted` method
     /// on the renderer is called with the health status of the frame.
     renderer: *Renderer,
     /// The target is presented via the provided renderer's API when completed.
     target: *Target,
 ) !Frame {
-    return try Frame.begin(.{ .queue = self.queue }, renderer, target);
+    const queue = self.queue orelse queue: {
+        const id = self.device.device.msgSend(?*anyopaque, objc.sel("newCommandQueue"), .{}) orelse
+            return error.MetalFailed;
+        const q = objc.Object.fromId(id);
+        self.queue = q;
+        break :queue q;
+    };
+    return try Frame.begin(.{ .queue = queue }, renderer, target);
 }
